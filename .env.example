# 복사해서 .env.local 로 쓰세요. 실제 값은 커밋하지 않습니다.
#
# 아래 두 값은 브라우저 번들에 포함되는 공개 값입니다. 안전한 이유는 키가
# 비밀이어서가 아니라 모든 테이블에 RLS가 켜져 있기 때문입니다(NFR-SEC-001).
# RLS 없이 이 키가 노출되면 데이터 전체가 열립니다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# service_role 키와 DB 접속 문자열은 이 저장소 어디에도 두지 않습니다.
# 필요할 때 Vercel 환경변수(Server 전용)나 로컬 셸에만 넣으세요.
# SUPABASE_SERVICE_ROLE_KEY=  <- 절대 커밋 금지, 브라우저에 노출 금지
# DATABASE_URL=               <- 마이그레이션 실행 시에만 셸에서 사용
