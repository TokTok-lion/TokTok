# 복사해서 .env.local 로 쓰세요. 실제 값은 커밋하지 않습니다.
#
# 아래 두 값은 브라우저 번들에 포함되는 공개 값입니다. 안전한 이유는 키가
# 비밀이어서가 아니라 모든 테이블에 RLS가 켜져 있기 때문입니다(NFR-SEC-001).
# RLS 없이 이 키가 노출되면 데이터 전체가 열립니다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ── 아래부터는 서버 전용입니다. NEXT_PUBLIC_ 을 붙이지 마세요. ──
# 붙이는 순간 브라우저 번들에 그대로 박혀서 누구나 꺼내 쓸 수 있습니다.

# 가사 쓰기 · 이야기 뽑기 · 활동일지 초안 (app/api/lyrics, /facts, /log-draft).
# 없으면 그 기능만 꺼지고 앱은 정상 동작합니다.
# OPENAI_API_KEY=sk-proj-xxxxxxxx
# OPENAI_MODEL=gpt-4o-mini      <- 생략하면 gpt-4o-mini

# service_role 키와 DB 접속 문자열은 이 저장소 어디에도 두지 않습니다.
# 필요할 때 Vercel 환경변수(Server 전용)나 로컬 셸에만 넣으세요.
# SUPABASE_SERVICE_ROLE_KEY=  <- 절대 커밋 금지, 브라우저에 노출 금지
# DATABASE_URL=               <- 마이그레이션 실행 시에만 셸에서 사용

# ── 전사(STT) · 읽어주기(TTS) : Google Cloud ──────────────────────
# 서비스 계정 JSON 을 통째로 한 줄에 넣습니다. 줄바꿈(\n)은 그대로 둡니다.
# 필요한 권한: Cloud Speech Client, Cloud Storage Object Admin
# GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...@....iam.gserviceaccount.com"}
#
# 1분 넘는 음성은 구글 규정상 Cloud Storage 를 거쳐야 합니다. 회기 녹음은
# 5~30분이라 예외 없이 이 길로 갑니다. 전사가 끝나면 코드가 바로 지우지만,
# 버킷에 수명 규칙(1일)도 함께 걸어 두세요 — 코드가 안 돌 수도 있습니다.
# GOOGLE_STT_BUCKET=toktok-stt-temp
# GOOGLE_TTS_VOICE=            <- 생략하면 ko-KR-Neural2-A

# ── 곡 만들기 : Suno 중계 서버 ────────────────────────────────────
# Suno 는 아직 공개 개발자 API 가 없습니다(2026년 7월 파트너 신청만 열림).
# 그래서 기관이 직접 띄운 중계 서버를 부릅니다. 그 서버가 Suno 계정 세션으로
# 대신 호출합니다.
#
# 주의: 이 주소가 열려 있으면 아무나 그 계정으로 곡을 만듭니다. 반드시
# 접근 보호(Vercel Deployment Protection 등)를 걸고, 아래 토큰도 함께 쓰세요.
# SUNO_API_URL=https://<내-중계-서버>.vercel.app
# SUNO_API_TOKEN=              <- 중계 서버에 자물쇠를 걸었다면 그 열쇠

# ── 제공자 고르기 (생략하면 위 기본값) ─────────────────────────────
# STT_PROVIDER=google
# TTS_PROVIDER=google
# MUSIC_PROVIDER=suno
# MUSIC_LENGTH_MS=90000        <- 길이를 받아 주는 제공자에서만 쓰입니다
#                                 (Suno 는 길이 지정이 안 됩니다)

# 콘솔의 어림 요금 계산에 쓰는 곡당 단가(원). 브라우저에서 읽으므로 공개 값입니다.
# NEXT_PUBLIC_KRW_PER_SONG=28
# NEXT_PUBLIC_MUSIC_PROVIDER=suno
