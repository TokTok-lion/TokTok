# 복사해서 .env.local 로 쓰세요. 실제 값은 커밋하지 않습니다.
#
# 아래 두 값은 브라우저 번들에 포함되는 공개 값입니다. 안전한 이유는 키가
# 비밀이어서가 아니라 모든 테이블에 RLS가 켜져 있기 때문입니다(NFR-SEC-001).
# RLS 없이 이 키가 노출되면 데이터 전체가 열립니다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ── 아래부터는 서버 전용입니다. NEXT_PUBLIC_ 을 붙이지 마세요. ──
# 붙이는 순간 브라우저 번들에 그대로 박혀서 누구나 꺼내 쓸 수 있습니다.

# 가사 쓰기 · 이야기 뽑기 · 활동일지 초안 (app/api/lyrics, /facts, /log-draft).
# 없으면 그 기능만 꺼지고 앱은 정상 동작합니다.
# OPENAI_API_KEY=sk-proj-xxxxxxxx
# OPENAI_MODEL=gpt-4o-mini      <- 생략하면 gpt-4o-mini

# service_role 키와 DB 접속 문자열은 이 저장소 어디에도 두지 않습니다.
# 필요할 때 Vercel 환경변수(Server 전용)나 로컬 셸에만 넣으세요.
# SUPABASE_SERVICE_ROLE_KEY=  <- 절대 커밋 금지, 브라우저에 노출 금지
# DATABASE_URL=               <- 마이그레이션 실행 시에만 셸에서 사용

# ── 전사(STT) · 읽어주기(TTS) : Google Cloud ──────────────────────
# 서비스 계정 JSON 을 통째로 한 줄에 넣습니다. 줄바꿈(\n)은 그대로 둡니다.
# 필요한 권한: Cloud Speech Client, Cloud Storage Object Admin
# GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...@....iam.gserviceaccount.com"}
#
# 1분 넘는 음성은 구글 규정상 Cloud Storage 를 거쳐야 합니다. 회기 녹음은
# 5~30분이라 예외 없이 이 길로 갑니다. 전사가 끝나면 코드가 바로 지우지만,
# 버킷에 수명 규칙(1일)도 함께 걸어 두세요 — 코드가 안 돌 수도 있습니다.
# GOOGLE_STT_BUCKET=toktok-stt-temp
# GOOGLE_TTS_VOICE=            <- 생략하면 ko-KR-Neural2-A
#
# 인식 모델. 생략하면 latest_long(긴 대화용).
# 'default' 로 바꾸면 구문 힌트(주제에서 뽑은 낱말)가 살아납니다 —
# latest_long 은 힌트를 무시합니다. 대신 문장부호와 일반 낱말 정확도가
# 떨어집니다. 실제 회기 녹음으로 견줘 보고 정하세요.
# GOOGLE_STT_MODEL=            <- latest_long | default

# ── 곡 만들기 : Suno (APIFRAME 경유) — 기본 ───────────────────────
# 한국어 보컬 품질이 가장 낫습니다. 무료 플랜(카드 불필요)으로 몇 곡
# 만들어 볼 수 있어요. 열쇠는 apiframe.ai 에서 받습니다.
#
# 주의: APIFRAME 은 Suno 와 제휴 관계가 아니라고 스스로 밝힙니다. 생성물의
# 권리 관계는 그쪽 약관에 기대는 셈이라, 기관과 계약하기 전에 확인하세요.
# APIFRAME_API_KEY=
# APIFRAME_MODEL=              <- 생략하면 V4_5

# ── 곡 만들기 : Treblo (구 Sonauto) — 대안 ────────────────────────
# 공식 REST API 이고, 만든 곡의 상업적 이용권을 함께 줍니다. 한국어 보컬도
# 됩니다. 곡당 약 $0.05. 열쇠는 treblo.com/developers 에서 받습니다.
# TREBLO_API_KEY=

# ── (안 씀) 곡 만들기 : Suno 중계 서버 ────────────────────────────
# Suno 는 공개 개발자 API 가 없습니다(2026년 7월 파트너 신청만 열림).
# 중계 서버(gcui-art/suno-api)는 2025년 1월부터 헤드리스 브라우저로 접속하고
# hCaptcha 를 대행 서비스로 푸는 구조라, 기관에 파는 서비스에는 쓰지 않습니다.
# 공식 파트너 API 가 열리면 music-suno.ts 만 고쳐서 되살리면 됩니다.
# SUNO_API_URL=
# SUNO_API_TOKEN=

# ── 제공자 고르기 (생략하면 위 기본값) ─────────────────────────────
# STT_PROVIDER=google        <- google(v1) | googleV2(v2 chirp_3)
#
# v1 은 한국어 화자 분리가 되지 않습니다(재서 확인했습니다 — 같은 설정으로
# 영어는 갈리고 한국어는 늘 화자표 하나입니다). 화자가 안 갈리면 사실 추출
# 입력에 복지사 질문이 섞입니다.
#
# googleV2 는 chirp_3 를 씁니다. 화자 분리가 되고, 인식도 낫고(v1 이 '차 벌금'
# 으로 듣던 '첫 월급'을 맞춥니다), m4a 도 그대로 읽습니다.
#
# 다만 지금은 eu 지역에서만 됩니다 — 어르신 음성이 유럽으로 갑니다.
# asia-southeast1 은 같은 모델에 403 이 오는데, 프로젝트 허용을 요청하면
# 열릴 수 있습니다. 열리면 GOOGLE_STT_REGION 만 바꾸면 됩니다.
# GOOGLE_STT_REGION=           <- 생략하면 eu
# GOOGLE_STT_V2_MODEL=         <- 생략하면 chirp_3
# TTS_PROVIDER=google
# MUSIC_PROVIDER=apiframe     <- apiframe | treblo | suno
# MUSIC_LENGTH_MS=120000       <- 회상용 노래는 120초. Treblo 만 이 값을 씁니다
#                                (90초는 가사 12줄을 느리게 부르기에 모자랐습니다)
#                                 (Suno 는 길이 지정이 안 됩니다)

# 콘솔의 어림 요금 계산에 쓰는 곡당 단가(원). 브라우저에서 읽으므로 공개 값입니다.
# NEXT_PUBLIC_KRW_PER_SONG=70   <- Treblo 곡당 약 $0.05
# NEXT_PUBLIC_MUSIC_PROVIDER=apiframe
