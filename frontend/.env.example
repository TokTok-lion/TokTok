# 복사해서 .env.local 로 쓰세요. 실제 값은 커밋하지 않습니다.
#
# 아래 두 값은 브라우저 번들에 포함되는 공개 값입니다. 안전한 이유는 키가
# 비밀이어서가 아니라 모든 테이블에 RLS가 켜져 있기 때문입니다(NFR-SEC-001).
# RLS 없이 이 키가 노출되면 데이터 전체가 열립니다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ── 아래부터는 서버 전용입니다. NEXT_PUBLIC_ 을 붙이지 마세요. ──
# 붙이는 순간 브라우저 번들에 그대로 박혀서 누구나 꺼내 쓸 수 있습니다.

# 활동일지 AI 초안(app/api/log-draft). 없으면 그 기능만 꺼지고 앱은 정상 동작합니다.
# OPENAI_API_KEY=sk-proj-xxxxxxxx
# OPENAI_MODEL=gpt-4o-mini      <- 생략하면 gpt-4o-mini

# service_role 키와 DB 접속 문자열은 이 저장소 어디에도 두지 않습니다.
# 필요할 때 Vercel 환경변수(Server 전용)나 로컬 셸에만 넣으세요.
# SUPABASE_SERVICE_ROLE_KEY=  <- 절대 커밋 금지, 브라우저에 노출 금지
# DATABASE_URL=               <- 마이그레이션 실행 시에만 셸에서 사용

# 질문 읽어주기(app/api/tts). 없으면 그 버튼만 사라지고 앱은 정상 동작합니다.
# ELEVENLABS_API_KEY=sk_xxxxxxxx      <- 'sk_' 로 시작하는 값. 목록의 ID 가 아닙니다
# ELEVENLABS_VOICE_ID=                <- 생략하면 Alice (또렷한 여성 중년)
# ELEVENLABS_MODEL=                   <- 생략하면 eleven_flash_v2_5 (크레딧 절반)
# MUSIC_LENGTH_MS=90000              <- 곡 길이. 요금이 여기에 정비례합니다
#                                       (실측: 60초 750크레딧, 30초 378크레딧)
