# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# the template carries no real values and needs to be shared
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# original design deck + illustration archive fed to scripts/prepare-*.py.
# Large binaries; the generated public/art and public/brand ARE committed.
/assets-src
/brand-check.png
